# DNS test endpoints (public browser variables)
NEXT_PUBLIC_DOH_FILTERED=https://dns.secretchip.net/dns-query
NEXT_PUBLIC_DOH_OPEN=https://nofilter.dns.secretchip.net/dns-query
NEXT_PUBLIC_DNS_TEST_QUERY_DOMAIN=example.com
NEXT_PUBLIC_BLOCK_TEST_DOMAIN=dns-block-test.secretchip.net

# DNS test domains used by API routes
DNS_TEST_QUERY_DOMAIN=example.com
BLOCK_TEST_DOMAIN=dns-block-test.secretchip.net

# Contact delivery (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=hello@secretchip.net

# Optional Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
