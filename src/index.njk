---
layout: base.njk
title: false
description: SecretChip is a security partner for teams that need protective DNS and senior security leadership. Block threats with AEGIS PDNS and lead your program with our vCISO service. Talk to us.
---

{% set heroWide = true %}
{% set eyebrow = "SecretChip · Practical security" %}
{% set heroTitle = 'Security that <span class="gradient-text">earns trust — and proves it</span>.' %}
{% set heroLead = "We help teams block threats and pass scrutiny — with protective DNS you can verify, and senior security leadership on demand. Tell us what you're protecting." %}
{% set heroPrimaryLabel = "Talk to us" %}
{% set heroPrimaryHref = "/contact/" %}
{% set heroSecondaryLabel = "See what we do" %}
{% set heroSecondaryHref = "#products" %}
{% include "page-hero.njk" %}

<section id="products" class="section">
  {% set eyebrow = "What we do" %}{% set heading = "Two ways we strengthen your security" %}{% set asH1 = false %}{% set center = true %}{% set desc = "Pick the entry point that fits — or run both together." %}
  {% include "section-heading.njk" %}

  <div class="grid2" style="margin-top: 24px;">
    {% for p in site.products %}
      <div class="card product-card {{ p.key }}">
        <span class="product-tag">{{ p.tag }}</span>
        <h3>{{ p.name }}</h3>
        <p>{{ p.tagline }}</p>
        <ul class="checks product-feats">
          {% for pt in p.points %}<li>{{ pt }}</li>{% endfor %}
        </ul>
        <div class="btnrow">
          <a class="btn {% if p.key == 'aegis' %}primary{% else %}purple{% endif %}" href="{{ p.href }}">{{ p.ctaLabel }}</a>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<section class="band section">
  <div class="band-inner">
    {% set eyebrow = "Why SecretChip" %}{% set heading = "Security you can reason about" %}{% set asH1 = false %}{% set center = true %}{% set desc = "We favor controls you can validate over promises you have to take on faith." %}
    {% include "section-heading.njk" %}

    <div class="grid3" style="margin-top: 24px;">
      <div class="card"><h3>Testable</h3><p>Public test domains and clear deliverables — verify what's happening instead of guessing.</p></div>
      <div class="card"><h3>Deployable</h3><p>Realistic rollout for devices, routers, and fleets, and roadmaps teams can actually execute.</p></div>
      <div class="card"><h3>Led</h3><p>Senior security leadership ties it all to governance, compliance, and board priorities.</p></div>
    </div>
  </div>
</section>

<section class="section">
  {% set center = true %}
  {% set ctaTitle = "Let's talk about what you're protecting" %}
  {% set ctaText = "Bring your constraints and goals. We'll map a practical plan across AEGIS PDNS, vCISO, or both — no obligation." %}
  {% set ctaPrimaryLabel = "Talk to us" %}
  {% set ctaPrimaryHref = "/contact/" %}
  {% set ctaSecondaryLabel = "Explore AEGIS PDNS" %}
  {% set ctaSecondaryHref = "/aegis-pdns/" %}
  {% include "cta.njk" %}
</section>
