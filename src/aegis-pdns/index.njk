  <div>
    {% set heading = "Sample DoH query" %}{% set desc = "RFC 8484 DoH wire query against the AEGIS PDNS filtered resolver. The same shape works against any DoH endpoint in the table above." %}
    {% include "section-heading.njk" %}

    <div class="code-block" style="margin-top: 16px;">
<span class="lang">shell</span><span class="cmt"># GET form: base64url-encoded binary DNS query as ?dns=…</span>
curl -sS -H <span class="hl">'accept: application/dns-message'</span> \
  <span class="hl-purple">'{{ site.endpoints.doh }}?dns=AAABAAABAAAAAAAABmdvb2dsZQNjb20AAAEAAQ'</span> \
  | xxd | head

<span class="cmt"># POST form: send the binary query in the request body</span>
curl -sS -X POST -H <span class="hl">'content-type: application/dns-message'</span> \
  --data-binary @query.bin <span class="hl-purple">{{ site.endpoints.doh }}</span> \
  | xxd | head</div>
    <p class="mini" style="margin-top: 8px;">The browser-based test page constructs and parses the binary frames in JavaScript &mdash; <a href="/aegis-pdns/test/">run it live →</a></p>
