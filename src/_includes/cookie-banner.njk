<div id="cookie-banner" role="dialog" aria-label="Cookie preferences" aria-live="polite">
  <div class="card">
    <div class="row">
      <p>
        We use strictly necessary cookies to run this site. Optional analytics and embedded content cookies require your consent.
      </p>
      <div class="btnrow" style="margin-top: 0;">
        <button type="button" class="btn primary" data-cookie-action="accept">Accept</button>
        <button type="button" class="btn" data-cookie-action="reject">Reject</button>
        <a class="btn purple" href="/legal/cookie-preferences/">Manage Preferences</a>
      </div>
    </div>
  </div>
</div>
