<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  {% set pageTitle = (title + " | " + site.company) if title else site.seoTitle %}
  {% set pageDesc = description if description else site.seoDescription %}

  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="apple-touch-icon" href="/assets/img/logo-full.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" />

  <link rel="stylesheet" href="/assets/css/site.css?v={{ assets.css }}" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ site.company }}" />
  <meta property="og:title" content="{{ pageTitle }}" />
  <meta property="og:description" content="{{ pageDesc }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ site.url }}/assets/img/logo-full.png" />
  <meta property="og:image:alt" content="{{ site.company }} logo" />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="{{ pageTitle }}" />
  <meta name="twitter:description" content="{{ pageDesc }}" />
  <meta name="twitter:image" content="{{ site.url }}/assets/img/logo-full.png" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.company }}",
    "url": "{{ site.url }}",
    "logo": "{{ site.url }}/assets/img/logo-full.png",
    "email": "{{ site.contactEmail }}",
    "description": "Protective DNS and virtual CISO (vCISO) security services.",
    "areaServed": "EU",
    "makesOffer": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "AEGIS PDNS — Protective DNS",
          "serviceType": "Protective DNS and DNS filtering",
          "description": "Encrypted protective DNS over DoH, DoT and DoQ that blocks malware, phishing and ransomware domains for businesses, MSPs and enterprises."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "vCISO — Virtual CISO",
          "serviceType": "Virtual CISO and security leadership",
          "description": "On-demand virtual CISO leadership for security strategy, governance and SOC 2, ISO 27001, NIST CSF, GDPR, NIS2 and DORA compliance."
        }
      }
    ]
  }
  </script>
</head>

<body id="top">
  <div class="wrap">
    {% include "header.njk" %}

    <main>
      {{ content | safe }}
    </main>

    {% include "footer.njk" %}
  </div>

  {% include "cookie-banner.njk" %}
  <script src="/assets/js/site.js?v={{ assets.js }}" defer></script>
</body>
</html>
