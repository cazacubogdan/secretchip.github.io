<div class="card cta-card">
  <div style="display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between;">
    <div style="flex: 1 1 320px; min-width: 260px;">
      <h3 style="margin: 0; font-size: 22px; color: var(--text-strong); font-weight: 600;">{{ ctaTitle }}</h3>
      <p style="margin: 8px 0 0; color: var(--soft); max-width: 64ch;">{{ ctaText }}</p>
    </div>
    <div class="btnrow" style="margin-top: 0;">
      <a class="btn primary" href="{{ ctaPrimaryHref }}">{{ ctaPrimaryLabel }}</a>
      {% if ctaSecondaryHref %}<a class="btn purple" href="{{ ctaSecondaryHref }}">{{ ctaSecondaryLabel }}</a>{% endif %}
    </div>
  </div>
</div>
