<div class="section-heading fade-up">
  {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
  {% if asH1 %}<h1>{{ heading }}</h1>{% else %}<h2>{{ heading }}</h2>{% endif %}
  {% if kicker %}<p class="kicker"><span class="kicker-prompt">›</span> {{ kicker | safe }}</p>{% endif %}
  {% if desc %}<p class="desc">{{ desc | safe }}</p>{% endif %}
</div>
