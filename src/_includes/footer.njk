<footer class="site">
  <div class="footer-grid">
    <div class="footer-brand">
      <a class="brand-link" href="/" aria-label="{{ site.company }} home">
        <img src="/assets/img/logo.svg" alt="" class="logo-mark" width="30" height="30" />
        <span class="wordmark">Secret<span class="chip">Chip</span></span>
      </a>
      <p>Practical security products and services — protective DNS with AEGIS PDNS, and on-demand security leadership with vCISO.</p>
    </div>
    {% for groupName, links in site.footerGroups %}
      <div>
        <h4>{{ groupName }}</h4>
        <ul>
          {% for link in links %}
            <li><a href="{{ link.href }}">{{ link.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endfor %}
  </div>

  <div class="footer-base">
    <div>© <span id="year">{{ "" | year }}</span> {{ site.company }}. All rights reserved.</div>
    <div>
      <a href="/legal/cookie-preferences/">Cookie preferences</a>
      <span aria-hidden="true"> · </span>
      <a href="/legal/">Legal hub</a>
    </div>
  </div>
</footer>
