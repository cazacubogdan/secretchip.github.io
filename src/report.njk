---
layout: base.njk
permalink: /report/
title: Redirecting
description: Redirecting to the issue tracker.
eleventyExcludeFromCollections: true
---

<section class="stack-xl" style="max-width: 720px; margin: 60px auto 0;">
  <div class="fade-up">
    {% set eyebrow = "Redirecting" %}{% set heading = "Issue tracker" %}{% set asH1 = true %}{% set kicker = "target: github issues · open in: 5s" %}{% set desc = "Reports, false positives, and feature requests live in the public tracker." %}
    {% include "section-heading.njk" %}
  </div>

  <div class="terminal" aria-hidden="true">
    <div class="terminal-bar">
      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
      <span class="title">secretchip ~ redirecting</span>
    </div>
    <div class="terminal-body"><span class="prompt">$</span> <span class="cmd">open</span> <span class="accent">{{ site.github.issues }}</span>
<span class="dim">→ redirecting in <strong id="redirSeconds">5</strong>s…</span>
<span class="prompt">$</span><span class="cursor"></span></div>
  </div>

  <p style="margin-top: 14px;">
    If you are not redirected automatically, open
    <a href="{{ site.github.issues }}">{{ site.github.issues }}</a>.
  </p>
</section>

<script>
  (function () {
    var target = "{{ site.github.issues }}";
    var total = 5;
    var s = total;
    var label = document.getElementById("redirSeconds");
    var t = setInterval(function () {
      s--;
      if (label) label.textContent = String(s);
      if (s <= 0) {
        clearInterval(t);
        window.location.replace(target);
      }
    }, 1000);
  })();
</script>
